{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProductsList",
  "type": "object",
  "required": ["products","total","skip","limit"],
  "properties": {
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id","title","category","price"],
        "properties": {
          "id": {"type": "integer"},
          "title": {"type": "string"},
          "category": {"type": "string"},
          "price": {"type": "number"}
        },
        "additionalProperties": true
      }
    },
    "total": {"type": "integer"},
    "skip": {"type": "integer"},
    "limit": {"type": "integer"}
  },
  "additionalProperties": true
}
